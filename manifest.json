{
  "manifest_version": 3,
  "name": "Google AI検索 - 右クリックで「とは」検索",
  "version": "1.0.0",
  "description": "選択したテキストに「とは」を付けてGoogle検索を新しいタブで開きます",
  "permissions": ["contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}